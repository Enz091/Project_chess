# Environnement
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Données et checkpoints : trop gros pour git (Kaggle Datasets / sorties)
data/*
!data/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pt.tmp
*.pgn
# parties de match (petites) : gardées dans git
!docs/*.pgn
!docs/stockfish/*.pgn
!docs/stockfish/*/*.pgn
*.pgn.zst

# Divers
.vscode/
.idea/
Thumbs.db

# Jeton de l'API Kaggle : ne doit JAMAIS entrer dans le dépôt (il donne accès à tout le compte)
kaggle.json
.kaggle/
access_token

# Logiciels externes téléchargés (Stockfish, Cute Chess) : gros binaires, hors git
tools/
